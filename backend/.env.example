NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://user:password@host:5432/switching?sslmode=require"

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

CORS_ORIGIN=http://localhost:3001

# Blockchain Gateway integration (external system, separate team).
# Keep GATEWAY_USE_MOCK=true until a real sandbox endpoint is available.
GATEWAY_BASE_URL=http://localhost:4000
GATEWAY_API_KEY=dev-gateway-key
GATEWAY_TIMEOUT_MS=10000
GATEWAY_USE_MOCK=true

# ---------------------------------------------------------------------------
# INBOUND WEBHOOK (Gateway → Switching POST /api/v1/webhooks/gateway)
# Layer 1 — identification (pre-hardening, required, static key)
GATEWAY_WEBHOOK_API_KEY=change-me-to-a-long-random-string
#
# Layer 2 — HMAC-SHA256 signature + timestamp anti-replay (Point #3)
# Shared secret — MUST be identical on the Gateway side. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Leave EMPTY during the graceful rollout window so mock-Gateway / e2e tests
# that only send X-Api-Key keep working (layer 2 SKIPPED if blank).
GATEWAY_WEBHOOK_SHARED_SECRET=
#
# Replay-protection tolerance: webhooks whose X-Gateway-Timestamp (UNIX ms)
# is older than this window are rejected. Default 5 minutes = 300000 ms.
GATEWAY_WEBHOOK_TOLERANCE_MS=300000
#
# Once the Gateway team has rolled out signing on their side, set this to
# TRUE to fail-closed: unsigned or bad-signature requests are rejected with
# 401 even when X-Api-Key is valid.
GATEWAY_WEBHOOK_SIGNATURE_REQUIRED=false

# ---------------------------------------------------------------------------
# OUTBOUND REQUEST (Switching → Gateway, e.g. POST /v1/transactions)
# Shared secret used to sign outgoing calls with the same HMAC-SHA256 format
# (timestamp + "." + rawBody). This CAN be the same value as
# GATEWAY_WEBHOOK_SHARED_SECRET or a DIFFERENT one per team agreement.
# Leave EMPTY to keep pre-hardening behaviour (no signing on outbound).
GATEWAY_OUTBOUND_SHARED_SECRET=
#
# Header naming for outgoing signature:
#   "switching-prefixed" → X-Switching-Signature / X-Switching-Timestamp (default)
#   "gateway-prefixed"   → X-Gateway-Signature  / X-Gateway-Timestamp
GATEWAY_OUTBOUND_HEADER_CONVENTION=switching-prefixed

# Retry / stale-pending timeouts (operational numbers from the MVP proposal)
TRANSACTION_PENDING_TIMEOUT_MS=60000
RETRY_BACKOFF_BASE_MS=5000
RETRY_MAX_ATTEMPTS=5
